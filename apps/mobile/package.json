{
  "name": "eight2five-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:mcp": "EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest --watchAll=false --passWithNoTests --runInBand",
    "expo:doctor": "npx expo-doctor",
    "expo:install-check": "npx expo install --check",
    "expo:install-fix": "npx expo install --fix",
    "validate": "npm run type-check && npm run lint && npm run test && npm run expo:doctor && npm run expo:install-check"
  },
  "dependencies": {
    "@eight2five/mobile": "*",
    "@eight2five/ui": "*",
    "expo": "~56.0.15",
    "expo-dev-client": "~56.0.22",
    "expo-router": "~56.2.14",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "expo-mcp": "~0.2.1",
    "expo-module-scripts": "^56.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "../../packages/mobile/src/**/*.{ts,tsx}",
      "../../modules/expo-pans-ble-api/src/**/*.{ts,tsx}"
    ]
  }
}
