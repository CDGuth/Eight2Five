{
  "name": "eight2five-testbed",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest --watchAll=false --passWithNoTests --runInBand",
    "validate:expo:doctor": "npx expo-doctor",
    "validate:expo:install-check": "npx expo install --check",
    "validate": "npm run type-check && npm run lint && npm run test && npm run validate:expo:doctor && npm run validate:expo:install-check"
  },
  "dependencies": {
    "@eight2five/mobile": "*",
    "@eight2five/ui": "*",
    "expo": "~55.0.26",
    "expo-dev-client": "~55.0.35",
    "expo-router": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "expo-module-scripts": "^55.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.18",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@eight2five/mobile/(.*)$": "<rootDir>/../../packages/mobile/src/$1"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "../../packages/mobile/src/**/*.{ts,tsx}",
      "../../modules/expo-kbeaconpro/src/**/*.{ts,tsx}",
      "../../modules/expo-pans-ble-api/src/**/*.{ts,tsx}"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
