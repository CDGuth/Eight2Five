{
  "name": "@eight2five/drill-importers",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "jest src --watchAll=false --passWithNoTests --runInBand"
  },
  "dependencies": {
    "@eight2five/drill-schema": "0.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": ["babel-preset-expo"]
        }
      ]
    },
    "moduleNameMapper": {
      "^@eight2five/drill-schema$": "<rootDir>/../drill-schema/src/index.ts",
      "^@eight2five/drill-schema/(.*)$": "<rootDir>/../drill-schema/src/$1"
    }
  }
}
