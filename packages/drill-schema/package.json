{
  "name": "@eight2five/drill-schema",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./drill-document.schema.json"
  },
  "files": [
    "src",
    "drill-document.schema.json"
