{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "default_agent": "engineer",
  "permission": {
    "websearch": "allow",
    "lsp": "allow"
  },
  "tools": {
    "websearch": true,
    "lsp": true
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
    },
    "docling": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "docling-mcp[local]",
        "docling-mcp-server",
        "--transport",
        "stdio"
      ],
      "environment": {
        "DOCLING_CONVERSION_MODE": "local",
        "CUDA_VISIBLE_DEVICES": ""
      },
      "enabled": true,
      "timeout": 1800000
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "engineer": {
      "mode": "primary",
      "prompt": "{file:./agents/engineer.md}",
      "temperature": 0.2,
      "top_p": 0.9
    },
    "explore": {
      "mode": "subagent",
      "prompt": "{file:./agents/explore.md}",
      "temperature": 0.4,
      "top_p": 0.95,
      "model": "opencode-go/kimi-k2.6",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "general": {
      "mode": "subagent",
      "prompt": "{file:./agents/general.md}",
      "temperature": 0.15,
      "top_p": 0.9,
      "model": "opencode-go/kimi-k2.6",
      "options": {
        "reasoningEffort": "medium"
      }
    }
  }
}