{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@eight2five/drill-schema": ["./packages/drill-schema/src/index"],
      "@eight2five/drill-schema/*": ["./packages/drill-schema/src/*"],
      "@eight2five/mobile": ["./packages/mobile/src/index"],
      "@eight2five/mobile/*": ["./packages/mobile/src/*"]
    }
  },
  "include": [
    "apps/**/*",
    "packages/**/*",
    "modules/**/*",
    "eslint.config.js",
    "babel.config.js"
  ],
  "exclude": ["node_modules"]
}
