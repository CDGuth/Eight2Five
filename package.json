{
  "name": "eight2five",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/expo-kbeaconpro",
    "modules/expo-pans-ble-api"
  ],
  "scripts": {
    "start:mobile": "pnpm --filter eight2five-mobile run start",
    "start:mobile:mcp": "pnpm --filter eight2five-mobile run start:mcp",
    "start:testbed": "pnpm --filter eight2five-testbed run start",
    "start:testbed:mcp": "pnpm --filter eight2five-testbed run start:mcp",
    "android:mobile": "pnpm --filter eight2five-mobile run android",
    "android:testbed": "pnpm --filter eight2five-testbed run android",
    "ios:mobile": "pnpm --filter eight2five-mobile run ios",
    "ios:testbed": "pnpm --filter eight2five-testbed run ios",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "type-check": "pnpm -r --if-present run type-check",
    "test": "pnpm -r --if-present run test",
    "validate:expo:doctor": "pnpm -r --if-present run validate:expo:doctor",
    "validate:expo:install-check": "pnpm -r --if-present run validate:expo:install-check",
    "validate:core": "pnpm type-check && pnpm lint && pnpm test",
    "validate": "pnpm validate:core && pnpm validate:expo:doctor && pnpm validate:expo:install-check"
  },
  "devDependencies": {
    "@expo/config-plugins": "^56.0.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.0",
    "babel-preset-expo": "~56.0.4",
    "typescript": "~6.0.3"
  }
}
