{
  "name": "eight2five",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/expo-kbeaconpro",
    "modules/expo-pans-ble-api"
  ],
  "scripts": {
    "start:mobile": "npm run start --workspace apps/mobile",
    "start:mobile:mcp": "npm run start:mcp --workspace apps/mobile",
    "start:testbed": "npm run start --workspace apps/testbed",
    "start:testbed:mcp": "npm run start:mcp --workspace apps/testbed",
    "android:mobile": "npm run android --workspace apps/mobile",
    "android:testbed": "npm run android --workspace apps/testbed",
    "ios:mobile": "npm run ios --workspace apps/mobile",
    "ios:testbed": "npm run ios --workspace apps/testbed",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:native:expo-pans-ble-api:ios": "npm run test:native:ios --workspace expo-pans-ble-api",
    "test:native:expo-pans-ble-api:android": "npm run test:native:android --workspace expo-pans-ble-api",
    "test:native:expo-pans-ble-api": "npm run test:native:expo-pans-ble-api:ios && npm run test:native:expo-pans-ble-api:android",
    "expo:doctor": "npm run expo:doctor --workspaces --if-present",
    "expo:install-check": "npm run expo:install-check --workspaces --if-present",
    "expo:install-fix": "npm run expo:install-fix --workspaces --if-present",
    "validate:expo:doctor": "npm run expo:doctor",
    "validate:expo:install-check": "npm run expo:install-check",
    "validate": "npm run type-check && npm run lint && npm run syncpack:lint && npm run test && npm run expo:doctor && npm run expo:install-check"
  },
  "devDependencies": {
    "@expo/config-plugins": "^56.0.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.0",
    "babel-preset-expo": "~56.0.4",
    "syncpack": "^15.3.2",
    "typescript": "~6.0.3"
  }
}
