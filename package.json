{
  "name": "eight2five",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/expo-kbeaconpro",
    "modules/expo-pans-ble-api"
  ],
  "scripts": {
    "start:mobile": "npm run start --workspace apps/mobile",
    "start:testbed": "npm run start --workspace apps/testbed",
    "android:mobile": "npm run android --workspace apps/mobile",
    "android:testbed": "npm run android --workspace apps/testbed",
    "ios:mobile": "npm run ios --workspace apps/mobile",
    "ios:testbed": "npm run ios --workspace apps/testbed",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate:expo:doctor": "npm run --workspace apps/mobile validate:expo:doctor && npm run --workspace apps/testbed validate:expo:doctor",
    "validate:expo:install-check": "npm run --workspace apps/mobile validate:expo:install-check && npm run --workspace apps/testbed validate:expo:install-check",
    "validate": "npm run type-check && npm run lint && npm run test && npm run validate:expo:doctor && npm run validate:expo:install-check"
  },
  "dependencies": {
    "@expo/html-elements": "^0.12.5",
    "@gluestack-ui/core": "^4.0.0-alpha.0",
    "@gluestack-ui/utils": "^4.0.0-alpha.0",
    "@gluestack/ui-next-adapter": "^4.0.0-alpha.0",
    "@legendapp/motion": "^2.5.3",
    "dom-helpers": "^5.2.1",
    "nativewind": "^4.2.4",
    "react-aria": "^3.49.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.19.13",
    "react-stately": "^3.47.0",
    "tailwind-variants": "^0.1.20"
  },
  "devDependencies": {
    "@react-native/assets-registry": "^0.79.7",
    "@types/react-native": "^0.72.8",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}
